# Backend Environment Configuration
# Copy this file to .env and update values for your environment

# ============================================
# Server
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# Database
# ============================================
MONGODB_URL=mongodb://localhost:27017/dcim

# ============================================
# Client URLs (CORS)
# ============================================
CLIENT_URLS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ============================================
# JWT / Auth
# ============================================
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=24h

# ============================================
# Email / Notifications
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
MAIL_FROM=noreply@dcim.local

# ============================================
# Prometheus & Monitoring
# ============================================
PROMETHEUS_URL=http://192.168.139.128:9090

# ============================================
# VM Discovery (Auto-discovery of Prometheus targets)
# ============================================

# Subnet (CIDR) or comma-separated list of IPs to scan for node_exporter
# Examples:
#   VM_DISCOVERY_SUBNET=192.168.139.0/24
#   VM_DISCOVERY_IPS=192.168.139.10,192.168.139.20,192.168.139.30
VM_DISCOVERY_SUBNET=192.168.139.0/24

# Port where node_exporter listens on VMs
NODE_EXPORTER_PORT=9100

# HTTP timeout for node_exporter health checks (milliseconds)
VM_CHECK_TIMEOUT=2000

# Job name used in Prometheus labels for discovered VMs
VM_JOB_NAME=vm-servers

# Interval between discovery scans (milliseconds, default 30 seconds)
VM_DISCOVERY_INTERVAL=30000

# Concurrency for HTTP checks (avoid overwhelming network)
VM_CHECK_CONCURRENCY=20

# ============================================
# File Upload
# ============================================
MAX_UPLOAD_SIZE=10mb
AVATAR_UPLOAD_DIR=./uploads/avatars

# ============================================
# Logging
# ============================================
LOG_LEVEL=debug
